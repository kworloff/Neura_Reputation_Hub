# ============================================
# Hardhat Contract Deployment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Private key of the account that will deploy contracts
# IMPORTANT: Never share this key or commit it to git!
# Format: 0x... (64 hex characters, no 0x prefix needed)
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Neura Testnet RPC URL (optional, defaults to Ankr)
# If not set, will use: https://rpc.ankr.com/neura_testnet
NEURA_RPC_URL=https://rpc.ankr.com/neura_testnet

# Etherscan API Key (optional, for contract verification)
# ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# Deployment Instructions:
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and add your PRIVATE_KEY (without 0x prefix)
# 3. Make sure you have ANKR tokens in your wallet for gas fees
# 4. Deploy contracts: cd contracts && npx hardhat run scripts/deploy.js --network neura_testnet
# 5. After deployment, update:
#    - config.json (contract addresses)
#    - frontend/.env.local (contract addresses)
#    - Netlify environment variables (if deployed)
